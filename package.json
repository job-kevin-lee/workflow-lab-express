{
  "name": "workflow-lab-express",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "projects/workflow-demo"
  ],
  "scripts": {
    "build": "bun run --filter @ideawithai/workflow-express build && bun run --filter @ideawithai/workflow-react build && bun run --filter @ideawithai/workflow-demo build",
    "pack:packages": "node scripts/pack-packages.mjs",
    "start": "bun run --filter @ideawithai/workflow-demo start",
    "smoke:packages": "node scripts/smoke-packages.mjs",
    "test": "bun test packages/workflow-express packages/workflow-react",
    "typecheck": "bun run --workspaces typecheck"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
